<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane" prefHeight="860.0" prefWidth="1400.0" styleClass="app-shell"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.otelotomasyon.MainController">

    <!-- ==========================================================================
         SOL MENÜ ÇUBUĞU (SIDEBAR NAVIGATION)
         ========================================================================== -->
    <left>
        <VBox prefWidth="265.0" styleClass="sidebar" BorderPane.alignment="CENTER">
            <!-- Marka / Otel Başlığı -->
            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="brand-box">
                <Label styleClass="brand-badge" text="OT" />
                <VBox spacing="2.0">
                    <Label styleClass="brand-title" text="OTEL OTOMASYON" />
                    <Label styleClass="brand-subtitle" text="Resepsiyon &amp; PMS Yönetim Sistemi" />
                </VBox>
            </HBox>

            <!-- Navigasyon Butonları -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="sidebar-scroll" VBox.vgrow="ALWAYS">
                <VBox spacing="3.0">
                    <padding>
                        <Insets bottom="12.0" left="10.0" right="10.0" top="6.0" />
                    </padding>

                    <Label styleClass="nav-section-label" text="GENEL BAKIŞ" />
                    <Button fx:id="btnNavDashboard" maxWidth="Infinity" onAction="#showDashboard"
                            styleClass="nav-btn, nav-btn-active" text="◈   Ana Ekran (Genel Bakış)" />

                    <Label styleClass="nav-section-label" text="GİRİŞ / ÇIKIŞ HAREKETLERİ" />
                    <Button fx:id="btnNavMusteriGiris" maxWidth="Infinity" onAction="#showMusteriGiris"
                            styleClass="nav-btn" text="⇥   Müşteri Giriş Yaptı" />
                    <Button fx:id="btnNavMusteriCikis" maxWidth="Infinity" onAction="#showMusteriCikis"
                            styleClass="nav-btn" text="⇤   Müşteri Çıkış Yaptı" />

                    <Label styleClass="nav-section-label" text="REZERVASYON İŞLEMLERİ" />
                    <Button fx:id="btnNavRezervasyonEkle" maxWidth="Infinity" onAction="#showRezervasyonEkle"
                            styleClass="nav-btn" text="＋   Rezervasyon Ekle" />
                    <Button fx:id="btnNavRezervasyonIptal" maxWidth="Infinity" onAction="#showRezervasyonIptal"
                            styleClass="nav-btn" text="✕   Rezervasyon İptal" />

                    <Label styleClass="nav-section-label" text="MÜŞTERİ &amp; MİSAFİR KAYIT" />
                    <Button fx:id="btnNavMusteriEkle" maxWidth="Infinity" onAction="#showMusteriEkle"
                            styleClass="nav-btn" text="👤   Müşteri Ekle" />
                    <Button fx:id="btnNavMisafirEkle" maxWidth="Infinity" onAction="#showMisafirEkle"
                            styleClass="nav-btn" text="👥   Oda Arkadaşı (Misafir) Ekle" />

                    <Label styleClass="nav-section-label" text="ODA &amp; KAT HİZMETLERİ" />
                    <Button fx:id="btnNavOdaEkle" maxWidth="Infinity" onAction="#showOdaEkle"
                            styleClass="nav-btn" text="⊞   Oda Ekle" />
                    <Button fx:id="btnNavOdaDuzenle" maxWidth="Infinity" onAction="#showOdaDuzenle"
                            styleClass="nav-btn" text="⚙   Oda Düzenleme" />
                    <Button fx:id="btnNavOdaTemizlendi" maxWidth="Infinity" onAction="#showOdaTemizlendi"
                            styleClass="nav-btn" text="✦   Oda Temizlendi" />

                    <Label styleClass="nav-section-label" text="FİNANS &amp; MUHASEBE" />
                    <Button fx:id="btnNavFaturaGoster" maxWidth="Infinity" onAction="#showFaturaGoster"
                            styleClass="nav-btn" text="🧾   Fatura Gösterme" />
                    <Button fx:id="btnNavBorcIslemleri" maxWidth="Infinity" onAction="#showBorcIslemleri"
                            styleClass="nav-btn" text="₺   Borç Görüntüle ve Borç Öde" />
                </VBox>
            </ScrollPane>

            <!-- Sol Alt Bar: Tema Değiştirici (Dark Mode Hazır) ve Çıkış -->
            <VBox spacing="8.0" styleClass="sidebar-footer">
                <Button fx:id="btnThemeToggle" maxWidth="Infinity" onAction="#onToggleThemeClick"
                        styleClass="nav-btn-theme" text="☾   Koyu Tema (Dark Mode)" />
                <Button fx:id="btnUygulamaCikis" maxWidth="Infinity" onAction="#onUygulamaCikisClick"
                        styleClass="nav-btn-exit" text="⏻   Uygulamadan Çıkış" />
            </VBox>
        </VBox>
    </left>

    <!-- ==========================================================================
         MERKEZ ALAN: ÜST BİLGİ BARI + EKRAN GEÇİŞ YIĞINI (STACKPANE)
         ========================================================================== -->
    <center>
        <BorderPane BorderPane.alignment="CENTER">

            <!-- ÜST BAR (HEADER) -->
            <top>
                <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="topbar">
                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                        <Label fx:id="lblTopbarTitle" styleClass="topbar-title" text="Ana Ekran • Otel Genel Bakış" />
                        <Label fx:id="lblTopbarSubtitle" styleClass="topbar-subtitle"
                               text="Canlı oda doluluk durumu, günlük giriş/çıkış hareketleri ve finansal özet" />
                    </VBox>
                    <HBox alignment="CENTER_RIGHT" spacing="10.0">
                        <Label fx:id="lblDbBaglantiDurumu" styleClass="topbar-db-pill" text="● Sistem Hazır" />
                        <Label fx:id="lblGununTarihi" styleClass="topbar-pill" text="17.11.2026" />
                        <Button onAction="#showRezervasyonEkle" styleClass="btn-primary" text="+ Hızlı Rezervasyon" />
                    </HBox>
                </HBox>
            </top>

            <!-- EKRANLARIN YER ALDIĞI STACKPANE -->
            <center>
                <StackPane fx:id="contentStack">

                    <!-- ======================================================================
                         1. ANA EKRAN (DASHBOARD - GENEL BAKIŞ & CANLI ODA TEMSİLLERİ)
                         ====================================================================== -->
                    <ScrollPane fx:id="viewDashboard" fitToWidth="true" styleClass="content-scroll">
                        <VBox spacing="22.0" styleClass="screen-container">

                            <!-- Üst KPI İstatistik Kartları (6'lı Dinamik Grid) -->
                            <GridPane hgap="16.0" vgap="16.0">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33" />
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33" />
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33" />
                                </columnConstraints>

                                <!-- KPI 1: Dolu / Boş Oda Sayısı -->
                                <VBox spacing="8.0" styleClass="kpi-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <HBox alignment="CENTER_LEFT">
                                        <Label styleClass="kpi-label" text="DOLU / MÜSAİT ODA DURUMU" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                                        <Label fx:id="lblDolulukYuzdeBadge" styleClass="badge, badge-occupied" text="58 Dolu" />
                                    </HBox>
                                    <HBox alignment="BASELINE_LEFT" spacing="10.0">
                                        <Label fx:id="lblDoluOdaSayisi" styleClass="kpi-value-accent" text="7 Dolu" />
                                        <Label styleClass="kpi-value" text="/" />
                                        <Label fx:id="lblBosOdaSayisi" styleClass="kpi-value-success" text="5 Müsait" />
                                    </HBox>
                                    <ProgressBar fx:id="prgDolulukOrani" maxWidth="Infinity" progress="0.58" />
                                    <Label fx:id="lblToplamOdaMeta" styleClass="kpi-meta" text="Toplam kayıtlı oda: 0" />
                                </VBox>

                                <!-- KPI 2: Günlük Giriş Yapacak İnsan Sayısı -->
                                <VBox spacing="8.0" styleClass="kpi-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <HBox alignment="CENTER_LEFT">
                                        <Label styleClass="kpi-label" text="BUGÜN GİRİŞ YAPACAK (CHECK-IN)" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                                        <Label styleClass="badge, badge-available" text="Beklenen Giriş" />
                                    </HBox>
                                    <HBox alignment="BASELINE_LEFT" spacing="8.0">
                                        <Label fx:id="lblGunlukGirisInsanSayisi" styleClass="kpi-value" text="9 Misafir" />
                                        <Label fx:id="lblGunlukGirisOdaSayisi" styleClass="kpi-meta" text="(4 Rezervasyon)" />
                                    </HBox>
                                    <Label fx:id="lblGunlukGirisDetay" styleClass="kpi-meta" text="Onaylı ve bugün check-in bekleyen misafir sayısı" />
                                    <HBox>
                                        <Button onAction="#showMusteriGiris" styleClass="btn-secondary" text="Check-In Ekranına Git →" />
                                    </HBox>
                                </VBox>

                                <!-- KPI 3: Günlük Çıkış Yapacak İnsan Sayısı -->
                                <VBox spacing="8.0" styleClass="kpi-card" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                    <HBox alignment="CENTER_LEFT">
                                        <Label styleClass="kpi-label" text="BUGÜN ÇIKIŞ YAPACAK (CHECK-OUT)" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                                        <Label styleClass="badge, badge-occupied" text="Beklenen Çıkış" />
                                    </HBox>
                                    <HBox alignment="BASELINE_LEFT" spacing="8.0">
                                        <Label fx:id="lblGunlukCikisInsanSayisi" styleClass="kpi-value" text="6 Misafir" />
                                        <Label fx:id="lblGunlukCikisOdaSayisi" styleClass="kpi-meta" text="(3 Oda)" />
                                    </HBox>
                                    <Label fx:id="lblGunlukCikisDetay" styleClass="kpi-meta" text="Çıkış tarihi bugün olan aktif konaklamalar" />
                                    <HBox>
                                        <Button onAction="#showMusteriCikis" styleClass="btn-secondary" text="Check-Out Ekranına Git →" />
                                    </HBox>
                                </VBox>

                                <!-- KPI 4: Temizlenecek Oda Sayısı -->
                                <VBox spacing="8.0" styleClass="kpi-card" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <HBox alignment="CENTER_LEFT">
                                        <Label styleClass="kpi-label" text="TEMİZLENECEK ODALAR (KAT HİZMETİ)" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                                        <Label styleClass="badge, badge-cleaning" text="Temizlik Bekliyor" />
                                    </HBox>
                                    <Label fx:id="lblTemizlenecekOdaSayisi" styleClass="kpi-value-warning" text="3 Oda" />
                                    <Label fx:id="lblTemizlenecekDetay" styleClass="kpi-meta" text="Çıkış yapılmış ve temizlik onayı bekleyen odalar" />
                                    <HBox>
                                        <Button onAction="#showOdaTemizlendi" styleClass="btn-secondary" text="Oda Temizlendi Bildir →" />
                                    </HBox>
                                </VBox>

                                <!-- KPI 5: Bakım Yapılacak / Arızalı Oda & Görev Sayısı -->
                                <VBox spacing="8.0" styleClass="kpi-card" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                    <HBox alignment="CENTER_LEFT">
                                        <Label styleClass="kpi-label" text="BAKIM / TEKNİK SERVİS DURUMU" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                                        <Label styleClass="badge, badge-danger" text="Teknik Bakım" />
                                    </HBox>
                                    <Label fx:id="lblBakimYapilacakSayisi" styleClass="kpi-value-danger" text="1 Oda" />
                                    <Label fx:id="lblBakimDetay" styleClass="kpi-meta" text="Bakımda olan veya durum güncellemesi bekleyen odalar" />
                                    <HBox>
                                        <Button onAction="#showOdaDuzenle" styleClass="btn-secondary" text="Oda Durumu Düzenle →" />
                                    </HBox>
                                </VBox>

                                <!-- KPI 6: Günlük Ciro & Bekleyen Tahsilat -->
                                <VBox spacing="8.0" styleClass="kpi-card" GridPane.columnIndex="2" GridPane.rowIndex="1">
                                    <HBox alignment="CENTER_LEFT">
                                        <Label styleClass="kpi-label" text="GÜNLÜK CİRO &amp; FİNANSAL ÖZET" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                                        <Label styleClass="badge, badge-available" text="Canlı Kasa" />
                                    </HBox>
                                    <Label fx:id="lblGunlukCiro" styleClass="kpi-value-success" text="₺28.450,00" />
                                    <Label fx:id="lblBekleyenBorcToplam" styleClass="kpi-meta" text="Tahsilat bekleyen açık bakiye: ₺6.200,00" />
                                    <HBox spacing="8.0">
                                        <Button onAction="#showBorcIslemleri" styleClass="btn-secondary" text="Borç &amp; Tahsilat →" />
                                        <Button onAction="#showFaturaGoster" styleClass="btn-secondary" text="Faturalar →" />
                                    </HBox>
                                </VBox>
                            </GridPane>

                            <!-- DB'deki Odaların Görsel Temsilleri (Canlı Oda Planı) -->
                            <VBox spacing="16.0" styleClass="card">
                                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="section-divider">
                                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                        <Label styleClass="card-title" text="Otel Oda Planı (Canlı Durum)" />
                                        <Label styleClass="card-subtitle"
                                               text="Odaların güncel durumunu görüntüleyin, filtreleyin veya bir odaya tıklayarak hızlıca işlem yapın." />
                                    </VBox>
                                    <TextField fx:id="txtDashboardOdaAra" prefWidth="210.0" promptText="Oda No veya Tip Ara (Örn: 101)..." />
                                    <Button fx:id="btnDashboardVeriYenile" onAction="#onDashboardYenileAction"
                                            styleClass="btn-secondary" text="↻ Verileri Yenile" />
                                    <Button onAction="#showOdaEkle" styleClass="btn-primary" text="+ Yeni Oda Ekle" />
                                </HBox>

                                <!-- Durum Filtre Çipleri -->
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Label styleClass="field-label" text="Durum Filtresi:" />
                                    <Button fx:id="btnFiltreTumu" onAction="#onFiltreTumuClick"
                                            styleClass="filter-chip, filter-chip-active" text="Tümü" />
                                    <Button fx:id="btnFiltreMusait" onAction="#onFiltreMusaitClick"
                                            styleClass="filter-chip" text="● Müsait" />
                                    <Button fx:id="btnFiltreDolu" onAction="#onFiltreDoluClick"
                                            styleClass="filter-chip" text="● Dolu" />
                                    <Button fx:id="btnFiltreTemizlenecek" onAction="#onFiltreTemizlenecekClick"
                                            styleClass="filter-chip" text="● Temizlenecek" />
                                    <Button fx:id="btnFiltreBakimda" onAction="#onFiltreBakimdaClick"
                                            styleClass="filter-chip" text="● Bakımda" />
                                </HBox>

                                <!-- Dinamik Oda Kartları Konteyneri (Java/DB tarafından doldurulur) -->
                                <FlowPane fx:id="flowOdaTemsilleri" hgap="14.0" vgap="14.0" prefWrapLength="1050.0" />
                            </VBox>

                        </VBox>
                    </ScrollPane>

                    <!-- ======================================================================
                         2. ODA EKLEME EKRANI (Odalar.java & Sql.odaEkle)
                         ====================================================================== -->
                    <ScrollPane fx:id="viewOdaEkle" fitToWidth="true" styleClass="content-scroll" visible="false">
                        <VBox spacing="20.0" styleClass="screen-container">
                            <GridPane hgap="22.0" vgap="20.0">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="48.0" />
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="52.0" />
                                </columnConstraints>

                                <!-- Sol: Yeni Oda Ekleme Formu -->
                                <VBox spacing="16.0" styleClass="card" GridPane.columnIndex="0">
                                    <VBox spacing="4.0" styleClass="section-divider">
                                        <Label styleClass="card-title" text="Yeni Oda Tanımlama Formu" />
                                        <Label styleClass="card-subtitle"
                                               text="Otele yeni bir oda tanımlayın." />
                                    </VBox>

                                    <VBox spacing="6.0">
                                        <Label styleClass="field-label" text="Oda Numarası *" />
                                        <TextField fx:id="txtOdaEkleNo" promptText="Örn: 101, 204, 305..." />
                                        <Label styleClass="field-hint" text="Kat ve kapı numarasını benzersiz olarak giriniz." />
                                    </VBox>

                                    <VBox spacing="6.0">
                                        <Label styleClass="field-label" text="Oda Kapasitesi *" />
                                        <TextField fx:id="txtOdaEkleKapasite" promptText="Örn: 2, 3, 4..." />
                                        <Label styleClass="field-hint" text="Odada konaklayabilecek maksimum misafir sayısı (Gecelik ücret rezervasyon girişinde belirlenir)." />
                                    </VBox>

                                    <Label fx:id="lblOdaEkleBilgi" styleClass="field-hint"
                                           text="Not: Oda eklendiğinde ana ekrandaki oda haritasında otomatik olarak görünür." />

                                    <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                        <Button fx:id="btnOdaEkleTemizle" onAction="#onOdaEkleFormTemizleAction"
                                                styleClass="btn-secondary" text="Formu Temizle" />
                                        <Button fx:id="btnOdaEkleKaydet" onAction="#onOdaEkleKaydetAction"
                                                styleClass="btn-primary" text="＋ Odayı Kaydet" />
                                    </HBox>
                                </VBox>

                                <!-- Sağ: Eklenen Odalar Listesi & Önizleme -->
                                <VBox spacing="16.0" styleClass="card" GridPane.columnIndex="1">
                                    <HBox alignment="CENTER_LEFT" styleClass="section-divider">
                                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                            <Label styleClass="card-title" text="Kayıtlı Odalar Listesi" />
                                            <Label styleClass="card-subtitle" text="Sistemde tanımlı odalar, kapasiteleri ve güncel durumları" />
                                        </VBox>
                                        <Label fx:id="lblKayitliOdaSayisiBadge" styleClass="badge, badge-neutral" text="0 Oda Kayıtlı" />
                                    </HBox>

                                    <ListView fx:id="listKayitliOdalar" prefHeight="390.0" VBox.vgrow="ALWAYS" />
                                </VBox>
                            </GridPane>
                        </VBox>
                    </ScrollPane>

                    <!-- ======================================================================
                         3. MÜŞTERİ EKLEME EKRANI (Musteri.java & Sql.musteriEkle)
                         ====================================================================== -->
                    <ScrollPane fx:id="viewMusteriEkle" fitToWidth="true" styleClass="content-scroll" visible="false">
                        <VBox spacing="20.0" styleClass="screen-container">
                            <GridPane hgap="22.0" vgap="20.0">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                                </columnConstraints>

                                <!-- Sol: Müşteri Kayıt Formu -->
                                <VBox spacing="16.0" styleClass="card" GridPane.columnIndex="0">
                                    <VBox spacing="4.0" styleClass="section-divider">
                                        <Label styleClass="card-title" text="Yeni Müşteri Kayıt Formu" />
                                        <Label styleClass="card-subtitle"
                                               text="Kimlik ve iletişim bilgilerini girerek yeni müşteri profili oluşturun." />
                                    </VBox>

                                    <VBox spacing="6.0">
                                        <Label styleClass="field-label" text="T.C. Kimlik Numarası *" />
                                        <TextField fx:id="txtMusteriEkleTc" promptText="11 haneli T.C. Kimlik No giriniz..." />
                                    </VBox>

                                    <GridPane hgap="14.0">
                                        <columnConstraints>
                                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                                        </columnConstraints>
                                        <VBox spacing="6.0" GridPane.columnIndex="0">
                                            <Label styleClass="field-label" text="Ad *" />
                                            <TextField fx:id="txtMusteriEkleAd" promptText="Örn: Ahmet" />
                                        </VBox>
                                        <VBox spacing="6.0" GridPane.columnIndex="1">
                                            <Label styleClass="field-label" text="Soyad *" />
                                            <TextField fx:id="txtMusteriEkleSoyad" promptText="Örn: Yılmaz" />
                                        </VBox>
                                    </GridPane>

                                    <GridPane hgap="14.0">
                                        <columnConstraints>
                                            <ColumnConstraints hgrow="ALWAYS" percentWidth="55.0" />
                                            <ColumnConstraints hgrow="ALWAYS" percentWidth="45.0" />
                                        </columnConstraints>
                                        <VBox spacing="6.0" GridPane.columnIndex="0">
                                            <Label styleClass="field-label" text="Telefon Numarası *" />
                                            <TextField fx:id="txtMusteriEkleTelefon" promptText="Örn: 0555 123 45 67" />
                                        </VBox>
                                        <VBox spacing="6.0" GridPane.columnIndex="1">
                                            <Label styleClass="field-label" text="Doğum Tarihi *" />
                                            <DatePicker fx:id="dpMusteriEkleDogumTarihi" maxWidth="Infinity" promptText="GG.AA.YYYY" />
                                        </VBox>
                                    </GridPane>

                                    <VBox spacing="6.0">
                                        <Label styleClass="field-label" text="E-Posta Adresi (İsteğe Bağlı)" />
                                        <TextField fx:id="txtMusteriEkleEmail" promptText="ornek@eposta.com (Boş bırakılabilir)" />
                                    </VBox>

                                    <Label fx:id="lblMusteriEkleBilgi" styleClass="field-hint"
                                           text="Her müşteri T.C. Kimlik ve telefon numarası ile benzersiz olarak kaydedilir." />

                                    <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                        <Button fx:id="btnMusteriEkleTemizle" onAction="#onMusteriEkleFormTemizleAction"
                                                styleClass="btn-secondary" text="Temizle" />
                                        <Button fx:id="btnMusteriEkleKaydet" onAction="#onMusteriEkleKaydetAction"
                                                styleClass="btn-primary" text="👤 Müşteriyi Kaydet" />
                                    </HBox>
                                </VBox>

                                <!-- Sağ: Müşteri Rehberi / Son Kayıtlar -->
                                <VBox spacing="16.0" styleClass="card" GridPane.columnIndex="1">
                                    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="section-divider">
                                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                            <Label styleClass="card-title" text="Müşteri Rehberi &amp; Son Kayıtlar" />
                                            <Label styleClass="card-subtitle" text="Kayıtlı müşterileri T.C. veya telefon ile hızlıca inceleyin" />
                                        </VBox>
                                        <TextField fx:id="txtMusteriRehberAra" prefWidth="180.0" promptText="Müşteri ara..." />
                                    </HBox>
                                    <ListView fx:id="listKayitliMusteriler" prefHeight="390.0" VBox.vgrow="ALWAYS" />
                                </VBox>
                            </GridPane>
                        </VBox>
                    </ScrollPane>

                    <!-- ======================================================================
                         4. MÜŞTERİLERİN ODA ARKADAŞI (MİSAFİR) EKLEME EKRANI
                            (Sql.aktifRezervasyonIdGetirTcIle & Sql.musteriMisafirEkle)
                         ====================================================================== -->
                    <ScrollPane fx:id="viewMisafirEkle" fitToWidth="true" styleClass="content-scroll" visible="false">
                        <VBox spacing="20.0" styleClass="screen-container">
                            <GridPane hgap="22.0" vgap="20.0">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="48.0" />
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="52.0" />
                                </columnConstraints>

                                <!-- Sol: 1. Adım - Rezervasyon Sahibi Bulma & Oda Özeti -->
                                <VBox spacing="16.0" GridPane.columnIndex="0">
                                    <VBox spacing="14.0" styleClass="card">
                                        <VBox spacing="4.0" styleClass="section-divider">
                                            <Label styleClass="card-title" text="1. Adım: Asıl Rezervasyon Sahibini Bul" />
                                            <Label styleClass="card-subtitle"
