<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="860.0" prefWidth="1360.0" stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.otelotomasyon.HelloController">

    <!-- =========================================================================
         LEFT SIDEBAR (Exact InnGO Layout)
         ========================================================================= -->
    <left>
        <VBox prefWidth="250.0" styleClass="sidebar">
            <!-- Brand Logo Header -->
            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="brand-box">
                <Label minHeight="32.0" minWidth="32.0" styleClass="brand-icon" text="O"/>
                <Label styleClass="brand-title" text="InnGO"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button styleClass="collapse-btn" text="‹"/>
            </HBox>

            <!-- Navigation Menu -->
            <VBox spacing="2.0" VBox.vgrow="ALWAYS">
                <Label styleClass="nav-section-title" text="MAIN"/>

                <Button fx:id="btnNavOverview" maxWidth="Infinity" onAction="#showOverviewPage"
                        styleClass="nav-btn-active" text="⌂   Overview (Genel Bakış)"/>

                <Button fx:id="btnNavRooms" maxWidth="Infinity" onAction="#showRoomsPage"
                        styleClass="nav-btn" text="🛏   Rooms (Odalar)"/>

                <Button fx:id="btnNavBookings" maxWidth="Infinity" onAction="#showBookingsPage"
                        styleClass="nav-btn" text="📅   Bookings (Rezervasyon)"/>

                <Label styleClass="nav-section-title" text="COMMUNICATION"/>

                <HBox alignment="CENTER_LEFT">
                    <Button fx:id="btnNavCheckInOut" maxWidth="Infinity" onAction="#showCheckInOutPage"
                            styleClass="nav-btn" text="⇄   Check-In / Check-Out" HBox.hgrow="ALWAYS"/>
                    <Label styleClass="nav-badge-green" text="0">
                        <HBox.margin>
                            <Insets right="18.0"/>
                        </HBox.margin>
                    </Label>
                </HBox>

                <Label styleClass="nav-section-title" text="MANAGEMENT"/>

                <Button fx:id="btnNavGuests" maxWidth="Infinity" onAction="#showGuestsPage"
                        styleClass="nav-btn" text="👥   Guests (Müşteri &amp; Misafir)"/>

                <Button fx:id="btnNavHousekeeping" maxWidth="Infinity" onAction="#showHousekeepingPage"
                        styleClass="nav-btn" text="🧹   Housekeeping (Temizlik)"/>

                <HBox alignment="CENTER_LEFT">
                    <Button fx:id="btnNavBilling" maxWidth="Infinity" onAction="#showBillingPage"
                            styleClass="nav-btn" text="📄   Fatura &amp; Borç İşlemleri" HBox.hgrow="ALWAYS"/>
                    <Label styleClass="nav-badge-green" text="0">
                        <HBox.margin>
                            <Insets right="18.0"/>
                        </HBox.margin>
                    </Label>
                </HBox>
            </VBox>

            <!-- Bottom User Profile -->
            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="profile-box">
                <Label minHeight="42.0" minWidth="42.0" styleClass="avatar-circle" text="AO"/>
                <VBox alignment="CENTER_LEFT" spacing="2.0">
                    <Label styleClass="profile-name" text="Amara Okafor"/>
                    <Label styleClass="profile-role" text="Hotel Manager"/>
                </VBox>
            </HBox>
        </VBox>
    </left>

    <!-- =========================================================================
         CENTER MAIN AREA (Header + Scrollable Content Stack)
         ========================================================================= -->
    <center>
        <BorderPane>
            <!-- Top Header Bar -->
            <top>
                <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="top-header">
                    <VBox spacing="3.0">
                        <Label fx:id="lblPageTitle" styleClass="page-title" text="Overview"/>
                        <Label fx:id="lblPageSubtitle" styleClass="page-subtitle"
                               text="Today's live hotel performance"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <!-- Live Status Badge -->
                    <Label styleClass="live-pill" text="●  Live"/>

                    <!-- Theme & Notification Buttons -->
                    <Button styleClass="icon-circle-btn" text="☾"/>
                    <Button styleClass="icon-circle-btn" text="🔔"/>

                    <!-- Quick Action Button -->
                    <Button onAction="#showBookingsPage" styleClass="header-action-btn"
                            text="+ Yeni Rezervasyon"/>
                </HBox>
            </top>

            <!-- Center Dynamic Pages -->
            <center>
                <ScrollPane fitToWidth="true" styleClass="edge-to-edge-scroll">
                    <StackPane fx:id="contentStack" alignment="TOP_LEFT">
                        <padding>
                            <Insets bottom="32.0" left="32.0" right="32.0" top="8.0"/>
                        </padding>

                        <!-- =====================================================
                             PAGE 1: OVERVIEW (Exact dash.png Replica)
                             ===================================================== -->
                        <VBox fx:id="pageOverview" spacing="22.0">

                            <!-- 6 KPI Cards Grid (3 Columns x 2 Rows) -->
                            <GridPane hgap="20.0" vgap="20.0">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33"/>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33"/>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33"/>
                                </columnConstraints>
                                <rowConstraints>
                                    <RowConstraints vgrow="SOMETIMES"/>
                                    <RowConstraints vgrow="SOMETIMES"/>
                                </rowConstraints>

                                <!-- Card 1: Occupied Rooms -->
                                <VBox spacing="4.0" styleClass="stat-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label fx:id="lblOccupiedRooms" styleClass="stat-value" text="54"/>
                                    <Label styleClass="stat-label" text="Occupied Rooms (Dolu Odalar)"/>
                                    <Label styleClass="stat-subtext" text="+6 since yesterday"/>
                                </VBox>

                                <!-- Card 2: Available Rooms -->
                                <VBox spacing="4.0" styleClass="stat-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label fx:id="lblAvailableRooms" styleClass="stat-value" text="26"/>
                                    <Label styleClass="stat-label" text="Available Rooms (Müsait Odalar)"/>
                                    <Label styleClass="stat-subtext" text="Ready for booking"/>
                                </VBox>

                                <!-- Card 3: Occupancy Rate -->
                                <VBox spacing="4.0" styleClass="stat-card" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                    <Label fx:id="lblOccupancyRate" styleClass="stat-value" text="68%"/>
                                    <Label styleClass="stat-label" text="Occupancy Rate (Doluluk Oranı)"/>
                                    <Label styleClass="stat-subtext" text="+8% vs last week"/>
                                </VBox>

                                <!-- Card 4: Today's Check-ins -->
                                <VBox spacing="4.0" styleClass="stat-card" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <Label fx:id="lblTodayCheckIns" styleClass="stat-value" text="12"/>
                                    <Label styleClass="stat-label" text="Today's Check-ins (Bugünkü Girişler)"/>
                                    <Label styleClass="stat-subtext" text="3 arriving before noon"/>
                                </VBox>

                                <!-- Card 5: Today's Check-outs -->
                                <VBox spacing="4.0" styleClass="stat-card" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                    <Label fx:id="lblTodayCheckOuts" styleClass="stat-value" text="8"/>
                                    <Label styleClass="stat-label" text="Today's Check-outs (Bugünkü Çıkışlar)"/>
                                    <Label styleClass="stat-subtext" text="2 late check-outs"/>
                                </VBox>

                                <!-- Card 6: Today's Revenue -->
                                <VBox spacing="4.0" styleClass="stat-card" GridPane.columnIndex="2" GridPane.rowIndex="1">
                                    <Label fx:id="lblTodayRevenue" styleClass="stat-value" text="₺1.84M"/>
                                    <Label styleClass="stat-label" text="Today's Revenue (Bugünkü Gelir)"/>
                                    <Label styleClass="stat-subtext" text="+12% vs yesterday"/>
                                </VBox>
                            </GridPane>

                            <!-- Availability Calendar Card -->
                            <VBox spacing="16.0" styleClass="section-card">
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <Label styleClass="icon-box-blue" text="📅"/>
                                    <Label styleClass="section-title" text="Availability Calendar"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button fx:id="btn14Days" onAction="#onSelect14Days"
                                            styleClass="pill-toggle-active" text="14 Days"/>
                                    <Button fx:id="btn30Days" onAction="#onSelect30Days"
                                            styleClass="pill-toggle-inactive" text="30 Days"/>
                                </HBox>

                                <!-- Horizontal Day Cards Container (Populated dynamically in Controller) -->
                                <ScrollPane fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="NEVER"
                                            style="-fx-background-color: transparent; -fx-border-color: transparent;">
                                    <HBox fx:id="calendarDaysBox" spacing="10.0">
                                        <padding>
                                            <Insets bottom="4.0" top="2.0"/>
                                        </padding>
                                    </HBox>
                                </ScrollPane>
                            </VBox>

                            <!-- Action Required Card -->
                            <VBox spacing="14.0" styleClass="section-card">
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <Label styleClass="icon-box-red" text="⚠"/>
                                    <Label styleClass="section-title" text="Action Required"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="lblActionCount" styleClass="badge-red-count" text="3"/>
                                </HBox>

                                <!-- Alert Row 1 -->
                                <HBox alignment="CENTER_LEFT" onMouseClicked="#showBillingPage"
                                      spacing="14.0" styleClass="alert-row">
                                    <Label style="-fx-text-fill: #16A34A; -fx-font-size: 18px;" text="⚠"/>
                                    <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                                        <Label styleClass="alert-title"
                                               text="1 Payment Awaiting Confirmation (Ödeme Onayı Bekliyor)"/>
                                        <Label styleClass="alert-subtitle"
                                               text="Payment balance for Room 204 • Arrival at 2:00 PM"/>
                                    </VBox>
                                    <Label styleClass="alert-time" text="8 min ago   ›"/>
                                </HBox>

                                <!-- Alert Row 2 -->
                                <HBox alignment="CENTER_LEFT" onMouseClicked="#showHousekeepingPage"
                                      spacing="14.0" styleClass="alert-row">
                                    <Label style="-fx-text-fill: #D97706; -fx-font-size: 18px;" text="🧹"/>
                                    <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                                        <Label styleClass="alert-title"
                                               text="3 Rooms Waiting for Housekeeping (Temizlik Bekleyen Odalar)"/>
                                        <Label styleClass="alert-subtitle"
                                               text="Room 102, 205, 301 checked out • Waiting for cleaning confirmation"/>
                                    </VBox>
                                    <Label styleClass="alert-time" text="18 min ago   ›"/>
                                </HBox>

                                <!-- Alert Row 3 -->
                                <HBox alignment="CENTER_LEFT" onMouseClicked="#showCheckInOutPage"
                                      spacing="14.0" styleClass="alert-row">
                                    <Label style="-fx-text-fill: #DC2626; -fx-font-size: 18px;" text="⏰"/>
                                    <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                                        <Label styleClass="alert-title"
                                               text="2 Late Check-outs Detected (Gecikmiş Çıkış Kontrolü)"/>
                                        <Label styleClass="alert-subtitle"
                                               text="Room 108, 304 check-out time passed • Status update required"/>
                                    </VBox>
                                    <Label styleClass="alert-time" text="35 min ago   ›"/>
                                </HBox>
                            </VBox>
                        </VBox>

                        <!-- =====================================================
                             PAGE 2: ROOMS (Oda Ekleme & Oda Durum Yönetimi)
                             ===================================================== -->
                        <VBox fx:id="pageRooms" managed="false" spacing="22.0" visible="false">
                            <GridPane hgap="20.0" vgap="20.0">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                                </columnConstraints>

                                <!-- Yeni Oda Ekle Kartı -->
                                <VBox spacing="14.0" styleClass="section-card" GridPane.columnIndex="0">
                                    <Label styleClass="section-title" text="Yeni Oda Ekle (odaEkle)"/>
                                    <GridPane hgap="14.0" vgap="12.0">
                                        <columnConstraints>
                                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                                        </columnConstraints>

                                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                            <Label styleClass="form-label" text="Oda Numarası"/>
                                            <TextField fx:id="txtOdaNo" promptText="Örn: 101" styleClass="modern-input"/>
                                        </VBox>

                                        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                            <Label styleClass="form-label" text="Oda Tipi"/>
                                            <ComboBox fx:id="cmbOdaTip" maxWidth="Infinity" promptText="Oda Tipi Seçin"
                                                      styleClass="modern-input"/>
                                        </VBox>

                                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                            <Label styleClass="form-label" text="Oda Kapasitesi (Kişi)"/>
                                            <TextField fx:id="txtOdaKapasite" promptText="Örn: 2" styleClass="modern-input"/>
                                        </VBox>

                                        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                            <Label styleClass="form-label" text="Günlük Ücret (₺)"/>
                                            <TextField fx:id="txtGunlukUcret" promptText="Örn: 2500.0" styleClass="modern-input"/>
                                        </VBox>
                                    </GridPane>
                                    <HBox alignment="CENTER_RIGHT" spacing="12.0">
                                        <Label fx:id="lblOdaKayitSonuc" styleClass="page-subtitle" HBox.hgrow="ALWAYS"/>
                                        <Button onAction="#onOdaEkleClick" styleClass="btn-primary" text="+ Odayı Kaydet"/>
                                    </HBox>
                                </VBox>

                                <!-- Oda Durumu Değiştir Kartı -->
                                <VBox spacing="14.0" styleClass="section-card" GridPane.columnIndex="1">
                                    <Label styleClass="section-title" text="Oda Durumu Düzenle (odaDurumDuzenle)"/>
                                    <VBox spacing="6.0">
                                        <Label styleClass="form-label" text="Müşteri TC Kimlik Numarası"/>
                                        <TextField fx:id="txtOdaDurumTc" promptText="11 Haneli TC Kimlik No"
                                                   styleClass="modern-input"/>
                                    </VBox>
                                    <VBox spacing="6.0">
                                        <Label styleClass="form-label" text="Yeni Oda Durumu"/>
                                        <ComboBox fx:id="cmbYeniOdaDurum" maxWidth="Infinity" promptText="Durum Seçin"
                                                  styleClass="modern-input"/>
                                    </VBox>
                                    <HBox alignment="CENTER_RIGHT" spacing="12.0">
                                        <Label fx:id="lblOdaDurumSonuc" styleClass="page-subtitle" HBox.hgrow="ALWAYS"/>
                                        <Button onAction="#onOdaDurumGuncelleClick" styleClass="btn-warning"
                                                text="Durumu Güncelle"/>
                                    </HBox>
                                </VBox>
                            </GridPane>

                            <!-- Canlı Oda Kartları Önizlemesi -->
                            <VBox spacing="14.0" styleClass="section-card">
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <Label styleClass="icon-box-blue" text="🛏"/>
                                    <Label styleClass="section-title" text="Oda Durum Özeti (Canlı Görünüm)"/>
                                </HBox>
                                <FlowPane fx:id="roomsFlowPane" hgap="16.0" vgap="16.0"/>
                            </VBox>
                        </VBox>

                        <!-- =====================================================
                             PAGE 3: BOOKINGS (Rezervasyon Oluşturma & İptal)
                             ===================================================== -->
                        <VBox fx:id="pageBookings" managed="false" spacing="22.0" visible="false">
                            <GridPane hgap="20.0" vgap="20.0">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="65.0"/>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="35.0"/>
                                </columnConstraints>

                                <!-- Yeni Rezervasyon Formu -->
                                <VBox spacing="16.0" styleClass="section-card" GridPane.columnIndex="0">
                                    <Label styleClass="section-title" text="Yeni Rezervasyon Oluştur (rezervasyonEkle)"/>
                                    <GridPane hgap="16.0" vgap="14.0">
                                        <columnConstraints>
                                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                                        </columnConstraints>

                                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                            <Label styleClass="form-label" text="Müşteri TC Kimlik No"/>
                                            <TextField fx:id="txtRezTc" promptText="Örn: 12345678901" styleClass="modern-input"/>
                                        </VBox>

                                        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                            <Label styleClass="form-label" text="Oda Numarası"/>
                                            <TextField fx:id="txtRezOdaNo" promptText="Örn: 101" styleClass="modern-input"/>
                                        </VBox>

                                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                            <Label styleClass="form-label" text="Giriş Tarihi"/>
                                            <DatePicker fx:id="dpGirisTarihi" maxWidth="Infinity" styleClass="modern-input"/>
                                        </VBox>

                                        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                            <Label styleClass="form-label" text="Çıkış Tarihi"/>
                                            <DatePicker fx:id="dpCikisTarihi" maxWidth="Infinity" styleClass="modern-input"/>
                                        </VBox>

                                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                            <Label styleClass="form-label" text="Gecelik Ücret (₺)"/>
                                            <TextField fx:id="txtRezGecelikUcret" promptText="Örn: 2500" styleClass="modern-input"/>
                                        </VBox>

                                        <VBox alignment="CENTER_LEFT" spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                            <Label styleClass="form-label" text="Fatura Tercihi"/>
                                            <CheckBox fx:id="chkFaturaGiriste" text="Fatura girişte hemen kesilsin"/>
                                        </VBox>
                                    </GridPane>

                                    <HBox alignment="CENTER_RIGHT" spacing="12.0">
                                        <Label fx:id="lblRezSonuc" styleClass="page-subtitle" HBox.hgrow="ALWAYS"/>
                                        <Button onAction="#onMusteriMusaitlikKontrolClick" styleClass="header-action-btn"
                                                text="Müsaitlik Kontrol Et"/>
                                        <Button onAction="#onRezervasyonOlusturClick" styleClass="btn-primary"
                                                text="Rezervasyonu Tamamla"/>
                                    </HBox>
                                </VBox>

                                <!-- Rezervasyon İptal Kartı -->
                                <VBox spacing="16.0" styleClass="section-card" GridPane.columnIndex="1">
                                    <Label styleClass="section-title" text="Rezervasyon İptali (rezIptal)"/>
                                    <Label styleClass="page-subtitle" wrapText="true"
                                           text="İptal edilecek rezervasyon sahibinin telefon numarasını girerek aktif rezervasyonu iptal edebilirsiniz."/>
                                    <VBox spacing="6.0">
                                        <Label styleClass="form-label" text="Müşteri Telefon Numarası"/>
                                        <TextField fx:id="txtRezIptalTel" promptText="05XX XXX XX XX" styleClass="modern-input"/>
                                    </VBox>
                                    <Button maxWidth="Infinity" onAction="#onRezervasyonIptalClick"
                                            styleClass="btn-danger" text="Rezervasyonu İptal Et"/>
                                    <Label fx:id="lblRezIptalSonuc" styleClass="page-subtitle" wrapText="true"/>
                                </VBox>
                            </GridPane>
                        </VBox>

                        <!-- =====================================================
                             PAGE 4: CHECK-IN / CHECK-OUT (Müşteri Giriş & Çıkış)
                             ===================================================== -->
                        <VBox fx:id="pageCheckInOut" managed="false" spacing="22.0" visible="false">
                            <GridPane hgap="20.0" vgap="20.0">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                                </columnConstraints>

                                <!-- Check-In Kartı -->
                                <VBox spacing="16.0" styleClass="section-card" GridPane.columnIndex="0">
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                        <Label styleClass="icon-box-blue" text="🔑"/>
                                        <Label styleClass="section-title" text="Müşteri Giriş Yaptı (Check-In)"/>
                                    </HBox>
                                    <Label styleClass="page-subtitle" wrapText="true"
                                           text="Onaylanmış rezervasyonu bulunan müşterinin otele girişini onaylar ve odayı 'Dolu' durumuna geçirir."/>
                                    <VBox spacing="6.0">
                                        <Label styleClass="form-label" text="Müşteri Telefon Numarası"/>
                                        <TextField fx:id="txtCheckInTel" promptText="05XX XXX XX XX" styleClass="modern-input"/>
                                    </VBox>
                                    <Button maxWidth="Infinity" onAction="#onCheckInClick" styleClass="btn-success"
                                            text="✓ Giriş İşlemini Onayla (Check-In)"/>
                                    <Label fx:id="lblCheckInSonuc" styleClass="page-subtitle" wrapText="true"/>
                                </VBox>

                                <!-- Check-Out Kartı -->
                                <VBox spacing="16.0" styleClass="section-card" GridPane.columnIndex="1">
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                        <Label styleClass="icon-box-red" text="🚪"/>
                                        <Label styleClass="section-title" text="Müşteri Çıkış Yaptı (Check-Out)"/>
                                    </HBox>
                                    <Label styleClass="page-subtitle" wrapText="true"
                                           text="Müşterinin çıkışını yapar, odayı 'Temizlenecek' durumuna alır ve fatura/ödeme kontrolünü gerçekleştirir."/>
                                    <VBox spacing="6.0">
                                        <Label styleClass="form-label" text="Müşteri Telefon Numarası"/>
                                        <TextField fx:id="txtCheckOutTel" promptText="05XX XXX XX XX" styleClass="modern-input"/>
                                    </VBox>
                                    <Button maxWidth="Infinity" onAction="#onCheckOutClick" styleClass="btn-primary"
                                            text="Çıkış İşlemini Tamamla (Check-Out)"/>
                                    <Label fx:id="lblCheckOutSonuc" styleClass="page-subtitle" wrapText="true"/>
                                </VBox>
                            </GridPane>
                        </VBox>

                        <!-- =====================================================
                             PAGE 5: GUESTS (Müşteri Ekle & Misafir Ekle)
                             ===================================================== -->
                        <VBox fx:id="pageGuests" managed="false" spacing="22.0" visible="false">
                            <GridPane hgap="20.0" vgap="20.0">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="60.0"/>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="40.0"/>
                                </columnConstraints>

                                <!-- Müşteri Ekleme Kartı -->
                                <VBox spacing="16.0" styleClass="section-card" GridPane.columnIndex="0">
                                    <Label styleClass="section-title" text="Yeni Müşteri Kaydı (musteriEkle)"/>
                                    <GridPane hgap="14.0" vgap="12.0">
                                        <columnConstraints>
                                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                                        </columnConstraints>

                                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                            <Label styleClass="form-label" text="Ad"/>
                                            <TextField fx:id="txtMusteriAd" promptText="Adınız" styleClass="modern-input"/>
                                        </VBox>

                                        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                            <Label styleClass="form-label" text="Soyad"/>
                                            <TextField fx:id="txtMusteriSoyad" promptText="Soyadınız" styleClass="modern-input"/>
                                        </VBox>

                                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                            <Label styleClass="form-label" text="TC Kimlik No"/>
                                            <TextField fx:id="txtMusteriTc" promptText="11 Haneli TC" styleClass="modern-input"/>
                                        </VBox>

                                        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                            <Label styleClass="form-label" text="Telefon Numarası"/>
                                            <TextField fx:id="txtMusteriTel" promptText="05XX XXX XX XX" styleClass="modern-input"/>
                                        </VBox>

                                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                            <Label styleClass="form-label" text="Yaş"/>
                                            <TextField fx:id="txtMusteriYas" promptText="Örn: 28" styleClass="modern-input"/>
                                        </VBox>

                                        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                            <Label styleClass="form-label" text="E-Posta (İsteğe Bağlı)"/>
                                            <TextField fx:id="txtMusteriEmail" promptText="ornek@mail.com" styleClass="modern-input"/>
                                        </VBox>
                                    </GridPane>

                                    <HBox alignment="CENTER_RIGHT" spacing="12.0">
                                        <Label fx:id="lblMusteriSonuc" styleClass="page-subtitle" HBox.hgrow="ALWAYS"/>
                                        <Button onAction="#onMusteriEkleClick" styleClass="btn-primary"
                                                text="+ Müşteriyi Kaydet"/>
                                    </HBox>
                                </VBox>

                                <!-- Odaya Misafir Ekleme Kartı -->
                                <VBox spacing="16.0" styleClass="section-card" GridPane.columnIndex="1">
                                    <Label styleClass="section-title" text="Odaya Misafir Ekle (musteriMisafirEkle)"/>
                                    <Label styleClass="page-subtitle" wrapText="true"
                                           text="Aktif rezervasyonu olan müşterinin odasına beraber konaklayacak misafirleri bağlayın."/>
                                    <VBox spacing="6.0">
                                        <Label styleClass="form-label" text="Rezervasyon Sahibi TC Kimlik No"/>
                                        <TextField fx:id="txtRezSahibiTc" promptText="Rezervasyon Sahibi TC"
                                                   styleClass="modern-input"/>
                                    </VBox>
                                    <VBox spacing="6.0">
                                        <Label styleClass="form-label" text="Eklenecek Misafir TC Kimlik No"/>
                                        <TextField fx:id="txtMisafirTc" promptText="Misafir TC Kimlik No"
                                                   styleClass="modern-input"/>
                                    </VBox>
                                    <Button maxWidth="Infinity" onAction="#onMisafirEkleClick" styleClass="btn-primary"
                                            text="Misafiri Rezervasyona Ekle"/>
                                    <Label fx:id="lblMisafirSonuc" styleClass="page-subtitle" wrapText="true"/>
                                </VBox>
                            </GridPane>
                        </VBox>

                        <!-- =====================================================
                             PAGE 6: HOUSEKEEPING (Kat Hizmetleri & Temizlik)
                             ===================================================== -->
                        <VBox fx:id="pageHousekeeping" managed="false" spacing="22.0" visible="false">
                            <VBox spacing="16.0" styleClass="section-card">
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Label styleClass="icon-box-blue" text="🧹"/>
                                    <Label styleClass="section-title" text="Oda Temizliği Onayla (temizlikTamamlandi)"/>
                                </HBox>
                                <Label styleClass="page-subtitle"
                                       text="Temizliği tamamlanan oda numarasını girerek odanın durumunu tekrar 'Müsait' olarak güncelleyin."/>
                                <HBox alignment="CENTER_LEFT" spacing="14.0">
                                    <TextField fx:id="txtTemizlikOdaNo" prefWidth="260.0"
                                               promptText="Temizlenen Oda No (Örn: 102)" styleClass="modern-input"/>
                                    <Button onAction="#onTemizlikTamamlandiClick" styleClass="btn-success"
                                            text="✓ Temizlik Tamamlandı İşaretle"/>
                                    <Label fx:id="lblTemizlikSonuc" styleClass="page-subtitle"/>
                                </HBox>
                            </VBox>
                        </VBox>

                        <!-- =====================================================
                             PAGE 7: BILLING & DEBT (Fatura Kes, Görüntüle & Borç Öde)
                             ===================================================== -->
                        <VBox fx:id="pageBilling" managed="false" spacing="22.0" visible="false">
                            <GridPane hgap="20.0" vgap="20.0">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                                </columnConstraints>

                                <!-- Fatura Kesme Kartı -->
                                <VBox spacing="14.0" styleClass="section-card" GridPane.columnIndex="0">
                                    <Label styleClass="section-title" text="Yeni Fatura Kes (faturaKes)"/>
                                    <GridPane hgap="12.0" vgap="12.0">
                                        <columnConstraints>
                                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                                        </columnConstraints>

                                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                            <Label styleClass="form-label" text="Rezervasyon No (ID)"/>
                                            <TextField fx:id="txtFaturaRezId" promptText="Örn: 1" styleClass="modern-input"/>
                                        </VBox>

                                        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                            <Label styleClass="form-label" text="Fatura Başlığı / Ünvan"/>
                                            <TextField fx:id="txtFaturaBaslik" promptText="Ad Soyad veya Şirket"
                                                       styleClass="modern-input"/>
                                        </VBox>

                                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                            <Label styleClass="form-label" text="TC Kimlik / Vergi No"/>
                                            <TextField fx:id="txtFaturaVergiNo" promptText="Vergi / TC No"
                                                       styleClass="modern-input"/>
                                        </VBox>

                                        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                            <Label styleClass="form-label" text="Ödeme Yöntemi"/>
                                            <ComboBox fx:id="cmbOdemeYontemi" maxWidth="Infinity"
                                                      promptText="Seçiniz" styleClass="modern-input"/>
                                        </VBox>

                                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                            <Label styleClass="form-label" text="Toplam Tutar (₺)"/>
                                            <TextField fx:id="txtFaturaTutar" promptText="Örn: 7500.0"
                                                       styleClass="modern-input"/>
                                        </VBox>

                                        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                            <Label styleClass="form-label" text="Fatura Adresi"/>
                                            <TextField fx:id="txtFaturaAdres" promptText="İl / İlçe / Açık Adres"
                                                       styleClass="modern-input"/>
                                        </VBox>
                                    </GridPane>
                                    <HBox alignment="CENTER_RIGHT" spacing="12.0">
                                        <Label fx:id="lblFaturaKesSonuc" styleClass="page-subtitle" HBox.hgrow="ALWAYS"/>
                                        <Button onAction="#onFaturaKesClick" styleClass="btn-primary"
                                                text="Faturayı Oluştur"/>
                                    </HBox>
                                </VBox>

                                <!-- Borç Görüntüle / Öde & Fatura Sorgula Kartı -->
                                <VBox spacing="14.0" styleClass="section-card" GridPane.columnIndex="1">
                                    <Label styleClass="section-title"
                                           text="Fatura &amp; Borç Sorgulama / Ödeme"/>
                                    <VBox spacing="6.0">
                                        <Label styleClass="form-label" text="Müşteri Telefon Numarası"/>
                                        <TextField fx:id="txtSorguTelefon" promptText="05XX XXX XX XX"
                                                   styleClass="modern-input"/>
                                    </VBox>
                                    <HBox spacing="10.0">
                                        <Button onAction="#onFaturaGoruntuleClick" styleClass="header-action-btn"
                                                text="📄 Fatura Görüntüle"/>
                                        <Button onAction="#onBorcGoruntuleClick" styleClass="btn-warning"
                                                text="🔍 Borç Sorgula"/>
                                        <Button onAction="#onBorcOdeClick" styleClass="btn-success"
                                                text="💳 Borcu Öde"/>
                                    </HBox>
                                    <TextArea fx:id="txtFaturaVeBorcDetay" editable="false" prefHeight="155.0"
                                              promptText="Sorgulanan fatura veya borç detayları burada görüntülenecektir..."
                                              styleClass="modern-input" wrapText="true"/>
                                </VBox>
                            </GridPane>
                        </VBox>

                    </StackPane>
                </ScrollPane>
            </center>
        </BorderPane>
    </center>
</BorderPane>
